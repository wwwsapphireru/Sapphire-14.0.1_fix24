    <appSettings>
        <add key="PublicVersion" value="ver 14.0.1 Build 260501 FIX_r24_SdekReplaceGeo_BillingModern_Warmup_MobileSmallFixHtml_MobileStartPhotoJson_DownloadFileWebp_CarouselPromise_ReadmoreInit_StickyElement_PriceFrom_CriticalCss_ImageConvertor_SettingsRoles_ShoppingCartPopupType_MobileMainPageProducts_AdminRedirect_LandingInplace_StickyElementToTop_LocalizationGroups_ClosingReceipt_CratoCss_Carousel_MarkerplaceButtons_Bonuses2_Api_Tinkoff_Cookies_ProductPhotoLazyLoadInNews_ShowBriefDescriptionInMainMobileFix_ModalZIndex_LpDonate_ApiEmailAuth_ApiUnit_EmailCodeAuth_AvitoWebp_MaskPhone_301Redirects_EnableRedirect301_SettingsMail_CostWithoutDiscountInCart_CostWithoutDiscountInCheckoutCart_Sber_SaasData_MaskValidation_Modules_ShipingListOptional_CarouselInMaxMiniApp_ModulePreview_MobileVideoModal_PhotoArchive_ApiOrder_XmlEncoding_CustomerContacts_LogUpdateModules_BillConsigneeAddress_BringFriend_InstallSalesChannel_ExportCategories_YandexMapHint_TextByMultiplicity_Dist_ShippingIcon_AdvAuth_Dpd_Robokassa_ScrollIntoBlockLandings_UITabs_MobileCategoriesMain_MobileCategoryTrigger_YooKassa_MainPageProductsRemoveEmpptyBlock_СriticalCssErrorMessage_GtinShort_AlfabankCloseReceipt5_AlfabankNotify_InstallModule_GSSymbol" />
        <add key="Version" value="14.0.1" />
