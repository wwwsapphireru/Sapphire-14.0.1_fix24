@using AdvantShop.Customers
@*Vadim_Dyl_381073705: заявка на изменение данных (нативный Pyrus-механизм 14.0.1) *@
<div id="modalPersonalChange" data-modal-control data-modal-class="modal-personal-change"
     data-ng-controller="AdvPersonalModalCtrl as personalModal"
     data-ng-init="personalModal.customerId = '@CustomerContext.CustomerId'; personalModal.customerType = '@CustomerContext.CurrentCustomer.CustomerType'">
    <div class="modal-header" data-modal-header>
        <span data-ng-if="personalModal.customerType == 'LegalEntity'">Изменение данных</span>
        <span data-ng-if="personalModal.customerType != 'LegalEntity'">Изменение личных данных</span>
    </div>
    <div class="modal-content">
        <form name="personalChangeForm" novalidate>
            <div class="adv-passport-modal__legend">Пустые поля сохраняются сразу; изменения заполненных — по заявке.</div>

            @*Vadim_Dyl_381073705: юрлицо — заявка по контактному лицу и всем реквизитам организации (кроме паспортных 13–16)*@
            <div data-ng-if="personalModal.customerType == 'LegalEntity'">
                <div class="adv-passport-modal__subtitle">Контактное лицо</div>
                <div class="adv-passport-modal__grid">
                    @Html.Partial("_PersonalChangeContactFields")
                </div>

                <div class="adv-passport-modal__subtitle">Реквизиты организации</div>
                <div class="adv-passport-modal__grid">
                    <label class="adv-passport-modal__field" data-ng-repeat="field in personalModal.changeFields"
                           data-ng-class="{'adv-passport-modal__field--full': field.FieldAssignment === 1 || field.FieldAssignment === 2 || field.FieldAssignment === 8}">
                        <span class="adv-passport-modal__label">{{ ::field.Name }}</span>
                        <span class="flatpickr-custom" data-ng-if="field.FieldType == 4"
                              ng-flatpickr fp-opts="{dateFormat: 'd.m.Y', startDateFormat: 'Y-m-d', wrap: true, enableTime: false}">
                            <input type="text" class="input-small flatpickr-custom__input"
                                   data-ng-flatpickr-input
                                   data-ng-model="field.Value"
                                   data-ng-required="field.Required || field.WasFilled"
                                   data-mask-control
                                   data-mask-control-preset="date"
                                   data-adv-mask-empty-valid>
                            <span class="flatpickr-custom__toggle" data-toggle>
                                <svg width="14" height="14" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path fill="currentColor" d="M0 464c0 26.5 21.5 48 48 48h352c26.5 0 48-21.5 48-48V192H0v272zm320-196c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12h-40c-6.6 0-12-5.4-12-12v-40zm0 128c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12h-40c-6.6 0-12-5.4-12-12v-40zM192 268c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12h-40c-6.6 0-12-5.4-12-12v-40zm0 128c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12h-40c-6.6 0-12-5.4-12-12v-40zM64 268c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12H76c-6.6 0-12-5.4-12-12v-40zm0 128c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12H76c-6.6 0-12-5.4-12-12v-40zM400 64h-48V16c0-8.8-7.2-16-16-16h-32c-8.8 0-16 7.2-16 16v48H160V16c0-8.8-7.2-16-16-16h-32c-8.8 0-16 7.2-16 16v48H48C21.5 64 0 85.5 0 112v48h448v-48c0-26.5-21.5-48-48-48z"></path></svg>
                            </span>
                        </span>
                        <textarea class="input-small" rows="2" data-ng-if="field.FieldType == 3"
                                  data-ng-model="field.Value"
                                  data-ng-required="field.Required || field.WasFilled"
                                  maxlength="500"></textarea>
                        <input type="text" class="input-small" data-ng-if="field.FieldType != 3 && field.FieldType != 4"
                               data-ng-model="field.Value"
                               data-ng-required="field.Required || field.WasFilled"
                               maxlength="200">
                        <span class="adv-passport-modal__hint" data-ng-if="!field.WasFilled">Сохранится сразу, без согласования</span>
                    </label>
                </div>
            </div>

            <div class="adv-passport-modal__grid" data-ng-if="personalModal.customerType != 'LegalEntity'">
                @Html.Partial("_PersonalChangeContactFields")
                <label class="adv-passport-modal__field">
                    <span class="adv-passport-modal__label">День рождения</span>
                    <span class="flatpickr-custom" ng-flatpickr fp-opts="{dateFormat: 'd.m.Y', startDateFormat: 'Y-m-d', wrap: true, enableTime: false}">
                        <input type="text" class="input-small flatpickr-custom__input"
                               data-ng-flatpickr-input
                               data-ng-model="personalModal.change.birthday"
                               data-ng-required="!personalModal.isPrimaryPersonal('birthday')"
                               data-mask-control
                               data-mask-control-preset="date"
                               data-adv-mask-empty-valid>
                        <span class="flatpickr-custom__toggle" data-toggle>
                            <svg width="14" height="14" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
                                <path fill="currentColor" d="M0 464c0 26.5 21.5 48 48 48h352c26.5 0 48-21.5 48-48V192H0v272zm320-196c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12h-40c-6.6 0-12-5.4-12-12v-40zm0 128c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12h-40c-6.6 0-12-5.4-12-12v-40zM192 268c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12h-40c-6.6 0-12-5.4-12-12v-40zm0 128c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12h-40c-6.6 0-12-5.4-12-12v-40zM64 268c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12H76c-6.6 0-12-5.4-12-12v-40zm0 128c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12H76c-6.6 0-12-5.4-12-12v-40zM400 64h-48V16c0-8.8-7.2-16-16-16h-32c-8.8 0-16 7.2-16 16v48H160V16c0-8.8-7.2-16-16-16h-32c-8.8 0-16 7.2-16 16v48H48C21.5 64 0 85.5 0 112v48h448v-48c0-26.5-21.5-48-48-48z"></path>
                            </svg>
                        </span>
                    </span>
                    <span class="adv-passport-modal__hint" data-ng-if="personalModal.isPrimaryPersonal('birthday')">Сохранится сразу, без согласования</span>
                </label>
            </div>
        </form>
    </div>
    <div class="modal-footer" data-modal-footer>
        <button type="button" class="btn btn-small btn-confirm"
                data-button-validation
                data-ng-disabled="!personalModal.canSubmit()"
                data-button-validation-success="personalModal.sendRequest()">
            {{ personalModal.submitLabel() }}
        </button>
        <button type="button" class="btn btn-small btn-action" data-ng-click="personalModal.close()">Отмена</button>
    </div>
</div>
