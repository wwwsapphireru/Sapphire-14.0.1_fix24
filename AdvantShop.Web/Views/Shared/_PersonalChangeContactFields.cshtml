@*Vadim_Dyl_381073705: поля контактного лица в модалке заявки (ФИО, телефон, email) — для физлица и юрлица*@
<label class="adv-passport-modal__field">
    <span class="adv-passport-modal__label">Фамилия</span>
    <input type="text" class="input-small" data-ng-model="personalModal.change.lastname" maxlength="70" required>
</label>
<label class="adv-passport-modal__field">
    <span class="adv-passport-modal__label">Имя</span>
    <input type="text" class="input-small" data-ng-model="personalModal.change.firstname" maxlength="70" required>
</label>
<label class="adv-passport-modal__field">
    <span class="adv-passport-modal__label">Отчество</span>
    <input type="text" class="input-small" data-ng-model="personalModal.change.patronymic" maxlength="70">
</label>
<label class="adv-passport-modal__field">
    <span class="adv-passport-modal__label">Телефон</span>
    <input type="text" class="input-small" data-ng-model="personalModal.change.phone"
           data-mask-control data-mask-control-preset="phone" data-adv-mask-empty-valid
           maxlength="70" placeholder="Номер телефона" required>
</label>
<label class="adv-passport-modal__field">
    <span class="adv-passport-modal__label">Email</span>
    <input type="email" class="input-small" data-ng-model="personalModal.change.email" maxlength="200" required>
</label>
