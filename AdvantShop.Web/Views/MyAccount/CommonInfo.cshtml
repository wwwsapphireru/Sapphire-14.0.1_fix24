@using AdvantShop.Customers
@using AdvantShop.ViewModel.Common;
@model AdvantShop.Models.MyAccount.UserInfoModel
@*Vadim_Dyl_381073705: карточки ЛК по 12.0.5, блокировка заполненных полей, заявки в Pyrus*@
@{ 
    var useFullNameSuggestions = Model.SuggestionsModule != null && Model.SuggestionsModule.SuggestFullNameInClient;
    var isMobile = SettingsDesign.IsMobileTemplate;
    var personalInitial = Newtonsoft.Json.JsonConvert.SerializeObject(new
    {
        lastname = Model.LastName ?? "",
        firstname = Model.FirstName ?? "",
        patronymic = Model.Patronymic ?? "",
        phone = Model.Phone ?? "",
        email = Model.Email ?? "",
        birthday = Model.BirthDay != null ? Model.BirthDay.Value.ToString("dd.MM.yyyy") : "",
        phoneConfirmed = CustomerService.GetConfirmPhone(CustomerContext.CustomerId.ToString()),
        customerType = Model.CustomerTypeEntity.ToString()
    }).Replace("\"", "&quot;");
}

<form name="commonInfoForm" class="myaccount-common-info"
      data-ng-controller="AdvPersonalCardCtrl as personal"
      data-ng-init="myaccount.isReadonly = @(Model.IsForbiddenAsChangingGeneralData.ToLowerString()); personal.init(@Html.Raw(personalInitial))">
    <div class="myaccount-common-info__wrapper">
        <div class="myaccount-common-info__grid">

            @* Блок: Учётные данные *@
            <section class="myaccount-card">
                <div class="myaccount-card__header">
                    <h3 class="myaccount-card__title">Учётные данные</h3>
                </div>
                <div class="myaccount-card__body">
                    <div class="myaccount-grid myaccount-grid--2">
                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <div class="myaccount-field">
                                <span class="myaccount-field__label">Email:</span>
                                <span class="myaccount-field__value" data-ng-init="myaccount.user.email = '@Model.Email'">@Model.Email</span>
                            </div>
                        }
                        @if (Model.AllowChangePhone)
                        {
                            <div class="myaccount-field" data-ng-if="personal.isLocked('phone')">
                                <span class="myaccount-field__label">@T("MyAccount.CommonInfo.Phone"):</span>
                                <span class="myaccount-field__value" data-ng-bind="myaccount.user.phone">@Model.Phone</span>
                                @if (Model.CustomerTypeEntity == CustomerType.PhysicalEntity)
                                {
                                    <span class="myaccount-phone-status" data-ng-if="myaccount.phoneConfirmed">Телефон подтвержден</span>
                                }
                            </div>
                            <div class="myaccount-field" data-ng-if="!personal.isLocked('phone')">
                                <span class="myaccount-field__label @(SettingsCheckout.IsRequiredPhone ? "input-required" : "")">@T("MyAccount.CommonInfo.Phone"):</span>
                                <span class="myaccount-field__value">
                                    @Html.TextBoxFor(m => m.Phone,
                                      new
                                      {
                                          placeholder = T("Js.Phone.PhonePlaceholder"),
                                          data_mask_control = SettingsMain.EnablePhoneMask.ToLowerString(),
                                          data_mask_control_preset = "phone",
                                          data_adv_mask_empty_valid = "",
                                          @class = "input-small",
                                          data_ng_required = SettingsCheckout.IsRequiredPhone.ToLowerString(),
                                          data_ng_model = "myaccount.user.phone",
                                          autocomplete = "tel",
                                          data_ng_readonly = "myaccount.isReadonly",
                                          maxlength = 70
                                      })
                                </span>
                                @if (Model.CustomerTypeEntity == CustomerType.PhysicalEntity)
                                {
                                    <span class="myaccount-phone-status" data-ng-if="myaccount.phoneConfirmed">Телефон подтвержден</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="myaccount-field">
                                <span class="myaccount-field__label">@T("MyAccount.CommonInfo.Phone"):</span>
                                <span class="myaccount-field__value" data-ng-init="myaccount.user.phone = '@Model.Phone'">@Model.Phone</span>
                                @if (Model.CustomerTypeEntity == CustomerType.PhysicalEntity)
                                {
                                    <span class="myaccount-phone-status" data-ng-if="myaccount.phoneConfirmed">Телефон подтвержден</span>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="myaccount-card__actions">
                    <button ng-show="!myaccount.isReadonly && @(Model.AllowChangePhone ? "!personal.isLocked('phone')" : "false")"
                            data-button-validation data-button-validation-success="myaccount.saveUser()" type="button" class="btn btn-middle btn-confirm">
                        Сохранить
                    </button>
                    <button ng-show="!myaccount.isReadonly" type="button" class="btn btn-middle btn-action"
                            data-modal-open="modalPersonalChange"
                            data-ng-click="personal.openChange()">
                        Изменить данные
                    </button>
                    @if (Model.CustomerTypeEntity == CustomerType.PhysicalEntity && Model.CanConfirmPhone)
                    {
                        <button type="button" class="btn btn-middle btn-action"
                                data-ng-if="!myaccount.phoneConfirmed && myaccount.user.phone"
                                data-modal-open="modalConfirmPhone">
                            Подтвердить номер телефона
                        </button>
                    }
                </div>
            </section>

            @* Блок: Информация *@
            <section class="myaccount-card">
                <div class="myaccount-card__header">
                    <h3 class="myaccount-card__title">Информация</h3>
                </div>
                <div class="myaccount-card__body">
                    <div class="myaccount-grid myaccount-grid--2">
                        <div class="myaccount-field">
                            <span class="myaccount-field__label">@T("MyAccount.CommonInfo.RegistrationDate")</span>
                            <span class="myaccount-field__value">@Model.RegistrationDate</span>
                        </div>
                        @if (Model.IsEnabledBothTypesOfCustomers)
                        {
                            <div class="myaccount-field">
                                <span class="myaccount-field__label">@T("MyAccount.CommonInfo.CustomerTypeEntity")</span>
                                <span class="myaccount-field__value">@Model.CustomerTypeEntity.Localize()</span>
                            </div>
                        }
                        @if (Model.ShowCustomerGroup)
                        {
                            <div class="myaccount-field">
                                <span class="myaccount-field__label">@T("MyAccount.CommonInfo.CustomerGroup")</span>
                                <span class="myaccount-field__value">@Model.CustomerGroup</span>
                            </div>
                        }
                        @if (Model.ShowCustomerRole)
                        {
                            <div class="myaccount-field">
                                <span class="myaccount-field__label">@T("MyAccount.CommonInfo.CustomerType")</span>
                                <span class="myaccount-field__value">@Model.CustomerType</span>
                            </div>
                        }
                    </div>
                </div>
            </section>

        @* Блок: юрлицо — «Контактное лицо» и «Информация об организации» двумя карточками (2×2 как у физлица) *@
        @if (Model.CustomerTypeEntity == CustomerType.LegalEntity)
        {
            <section class="myaccount-card">
                <div class="myaccount-card__header">
                    <h3 class="myaccount-card__title">Контактное лицо</h3>
                </div>
                <div class="myaccount-card__body">
                    @Html.Partial("_ContactPersonFields", Model, new ViewDataDictionary(ViewData) { { "gridClass", "myaccount-grid--3" } })
                    @if (SettingsDesign.ShowUserAgreementForPromotionalNewsletter)
                    {
                        <label class="myaccount-checkbox">
                            @Html.CheckBoxFor(m => m.IsAgreeForPromotionalNewsletter, new { @class = "custom-input-native", data_ng_model = "myaccount.user.isAgreeForPromotionalNewsletter", data_e2e = "myAccountAgreeForPromotionalNewsletterCheckbox" })
                            <span class="custom-input-checkbox"></span>
                            <span class="myaccount-checkbox__text">@T("MyAccount.CommonInfo.UserAgreementForPromotionalNewsletter")</span>
                        </label>
                    }
                </div>
                <div class="myaccount-card__actions">
                    <button ng-show="!myaccount.isReadonly && personal.contactCanSave()"
                            data-button-validation data-button-validation-success="myaccount.saveUser()" type="button" class="btn btn-middle btn-confirm">
                        Сохранить
                    </button>
                    <button ng-show="!myaccount.isReadonly && personal.contactCanEdit()"
                            type="button" class="btn btn-middle btn-action"
                            data-modal-open="modalPersonalChange"
                            data-ng-click="personal.openChange()">
                        Изменить данные
                    </button>
                </div>
            </section>

            <section class="myaccount-card">
                <div class="myaccount-card__header">
                    <h3 class="myaccount-card__title">Информация об организации</h3>
                </div>
                <div class="myaccount-card__body">
                    @if (!string.IsNullOrEmpty(Model.Organization))
                    {
                        <div class="myaccount-row">
                            <span class="myaccount-row__label">@T("MyAccount.CommonInfo.Organization")</span>
                            <span class="myaccount-row__value">@Model.Organization</span>
                        </div>
                    }
                    <div class="myaccount-common-info__fields myaccount-grid myaccount-grid--2">
                        @Html.Partial("_CustomerFields", new CustomerFieldsViewModel(Model.CustomerFields,
                            ngModelName: "myaccount.user",
                            cssParamName: "col-xs-12 col-sm-4", cssParamValue: "col-xs-12 col-sm-8",
                            showMode: CustomerFieldShowMode.MyAccount, suggestions: Model.SuggestionsModule,
                            verticalIntervalCss: "vertical-interval-middle",
                            isForbiddenAsChangingGeneralData: Model.IsForbiddenAsChangingGeneralData,
                            showFilledAsText: true))
                    </div>
                </div>
                <div class="myaccount-card__actions">
                    <button ng-show="!myaccount.isReadonly && personal.orgCanSave()"
                            data-button-validation data-button-validation-success="myaccount.saveUser()" type="button" class="btn btn-middle btn-confirm">
                        Сохранить
                    </button>
                    <button ng-show="!myaccount.isReadonly && personal.orgCanEdit()"
                            type="button" class="btn btn-middle btn-action"
                            data-modal-open="modalPersonalChange"
                            data-ng-click="personal.openChange()">
                        Изменить данные
                    </button>
                </div>
            </section>
        }

        @if (Model.CustomerTypeEntity != CustomerType.LegalEntity)
        {
            @* Блок: Личные данные (физлицо) *@
            <section class="myaccount-card">
                <div class="myaccount-card__header">
                    <h3 class="myaccount-card__title">Личные данные</h3>
                </div>
                <div class="myaccount-card__body">
                    @Html.Partial("_ContactPersonFields", Model)

                    <div class="myaccount-field myaccount-field--dob" data-ng-if="personal.isLocked('birthday')">
                        <span class="myaccount-field__label">@((SettingsCheckout.BirthDayFieldName ?? "").TrimEnd(':')):</span>
                        <span class="myaccount-field__value" data-ng-bind="personal.formatBirthday(myaccount.user.birthday)">@(Model.BirthDay != null ? Model.BirthDay.Value.ToString("dd.MM.yyyy") : "")</span>
                    </div>
                    <div class="myaccount-field myaccount-field--dob" data-ng-if="!personal.isLocked('birthday')">
                        <span class="myaccount-field__label @(SettingsCheckout.IsRequiredBirthDay ? "input-required" : "")">@((SettingsCheckout.BirthDayFieldName ?? "").TrimEnd(':')):</span>
                        <span class="myaccount-field__value">
                            @if (!SettingsCheckout.IsDisableEditingBirthDay || Model.BirthDay == null)
                            {
                                <span class="flatpickr-custom"
                                      ng-flatpickr
                                      fp-opts="{dateFormat: 'd.m.Y', startDateFormat: 'Y-m-d', wrap: true, enableTime: false}">
                                    <input type="text"
                                           id="birthday"
                                           name="birthday"
                                           class="input-small flatpickr-custom__input" @Html.Raw(Model.BirthDay != null ? "value=\"" + Model.BirthDay.Value.ToString("dd.MM.yyyy") + "\"" : "")
                                           data-ng-required="@SettingsCheckout.IsRequiredBirthDay.ToLowerString()"
                                           ng-flatpickr-input
                                           ng-model="myaccount.user.birthday"
                                           data-mask-control
                                           data-mask-control-preset="date"
                                           data-adv-mask-empty-valid>
                                    <span class="flatpickr-custom__toggle" data-toggle>
                                        <svg width="14" height="14" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path fill="currentColor" d="M0 464c0 26.5 21.5 48 48 48h352c26.5 0 48-21.5 48-48V192H0v272zm320-196c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12h-40c-6.6 0-12-5.4-12-12v-40zm0 128c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12h-40c-6.6 0-12-5.4-12-12v-40zM192 268c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12h-40c-6.6 0-12-5.4-12-12v-40zm0 128c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12h-40c-6.6 0-12-5.4-12-12v-40zM64 268c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12H76c-6.6 0-12-5.4-12-12v-40zm0 128c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12H76c-6.6 0-12-5.4-12-12v-40zM400 64h-48V16c0-8.8-7.2-16-16-16h-32c-8.8 0-16 7.2-16 16v48H160V16c0-8.8-7.2-16-16-16h-32c-8.8 0-16 7.2-16 16v48H48C21.5 64 0 85.5 0 112v48h448v-48c0-26.5-21.5-48-48-48z"></path></svg>
                                    </span>
                                </span>
                            }
                            else
                            {
                                @Model.BirthDay.Value.ToString("dd.MM.yyyy")
                                <input name="birthday"
                                       ng-model="myaccount.user.birthday"
                                       type="hidden"
                                       value="@Model.BirthDay.Value.ToString("dd.MM.yyyy")" />
                            }
                        </span>
                    </div>

                    @if (SettingsDesign.ShowUserAgreementForPromotionalNewsletter)
                    {
                        <label class="myaccount-checkbox">
                            @Html.CheckBoxFor(m => m.IsAgreeForPromotionalNewsletter, new { @class = "custom-input-native", data_ng_model = "myaccount.user.isAgreeForPromotionalNewsletter", data_e2e = "myAccountAgreeForPromotionalNewsletterCheckbox" })
                            <span class="custom-input-checkbox"></span>
                            <span class="myaccount-checkbox__text">@T("MyAccount.CommonInfo.UserAgreementForPromotionalNewsletter")</span>
                        </label>
                    }
                </div>
                <div class="myaccount-card__actions">
                    <button ng-show="!myaccount.isReadonly && personal.canSave()"
                            data-button-validation data-button-validation-success="myaccount.saveUser()" type="button" class="btn btn-middle btn-confirm">
                        Сохранить
                    </button>
                    <button ng-show="!myaccount.isReadonly && personal.canEdit()"
                            type="button" class="btn btn-middle btn-action"
                            data-modal-open="modalPersonalChange"
                            data-ng-click="personal.openChange()">
                        Изменить данные
                    </button>
                </div>
            </section>

            @Html.Partial("_CustomerFields", new CustomerFieldsViewModel(Model.CustomerFields,
                ngModelName: "myaccount.user",
                cssParamName: "col-xs-12 col-sm-4", cssParamValue: "col-xs-12 col-sm-8",
                showMode: CustomerFieldShowMode.MyAccount, suggestions: Model.SuggestionsModule,
                verticalIntervalCss: "vertical-interval-middle",
                isForbiddenAsChangingGeneralData: Model.IsForbiddenAsChangingGeneralData))
        }
        </div>

        <section class="myaccount-card myaccount-card--plain myaccount-card--danger">
            <a href="" class="myaccount-card__danger-link"
               data-modal-open="modalDeleteAccount">Запрос на удаление личного кабинета</a>
        </section>
    </div>
</form>
@Html.Partial("_PassportChangeModal")
@Html.Partial("_PersonalChangeModal")
@Html.Partial("_DeleteAccountModal")
@if (Model.CanConfirmPhone)
{
    @* Vadim_Dyl_381073705: модалка SMS-подтверждения нужна только при включённом модуле SmsConfirmation *@
    @Html.Partial("_ConfirmPhoneModal")
}

