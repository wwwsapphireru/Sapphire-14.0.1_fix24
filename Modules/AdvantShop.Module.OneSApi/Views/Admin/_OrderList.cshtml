<div class="row m-b-md">
    <div class="col-xs-12">
        <div class="ibox" ng-if="oneExportOrders.IsRun">
            <div class="ibox-content">
                <div class="row">
                    <div class="col-xs-12">
                        <uib-progressbar max="oneExportOrders.ProgressTotal" value="oneExportOrders.ProgressValue">
                            <span style="color:white; white-space:nowrap;"><span ng-bind="oneExportOrders.ProgressValue"></span> / <span ng-bind="oneExportOrders.ProgressTotal"></span></span>
                        </uib-progressbar>
                    </div>
                </div>
                <div class="container-fluid">
                    <div class="form-group row">
                        <div class="col-xs-10">
                            Текущий процесс
                            <a class="link-decoration-none" ng-href="{{oneExportOrders.Process}}" ng-bind="oneExportOrders.ProcessName"></a>
                        </div>
                        <div class="col-xs-2" ng-show="true">
                            <input type="button" ng-click="oneExportOrders.breakProcess()" class="btn btn-sm btn-success" value="Прервать" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xs-12" ng-if="!oneExportOrders.IsRun && oneExportOrders.ExportFileName != null">
        <div class="form-group row">
            <div class="col-sm-2">
                <div class="setting-label-wrap">
                    Процесс завершен
                </div>
            </div>
            <div class="col-sm-10">
                <a ng-href="{{oneExportOrders.ExportFileName}}">Скачать файл экспорта</a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="form-group row">
        <div class="col-xs-12">
            <ui-grid-custom class="grid-properties"
                            grid-unique-id="gridOrders"
                            grid-extend-ctrl="oneExportOrders"
                            grid-row-identificator="'OrderId'"
                            grid-options="oneExportOrders.gridOptions"
                            grid-on-init="oneExportOrders.gridOnInit(gridOrders)"
                            grid-url="'../OneSAdmin/getOrderList'">
                <ui-grid-custom-footer class="ui-grid-custom-footer" ng-bind="oneExportOrders.grid.gridOptions.TotalString">
                </ui-grid-custom-footer>
            </ui-grid-custom>
        </div>
    </div>
</div>
