<div>
    <div class="sticky-page-name m-b-md">
        <div class="page-name-block sticky-page-name-inner">
            <div class="page-name-block-item-main">
                <h1 class="page-name-block-text sticky-page-name-text">
                    Методы доставки
                </h1>
            </div>
            <div class="page-name-block-item-additional">
                <ui-modal-trigger data-controller="'ModalAddEditShippingMethodCtrl'" controller-as="ctrl"
                                  on-close="oneSettings.gridShippingMethods.fetchData()"
                                  template-url="../modules/OneSApi/content/scripts/admin/settings/modals/ModalAddEditShippingMethod.html">
                    <button class="btn btn-sm btn-success btn--margin-left" type="button">
                        <span class="fa fa-plus"></span> Добавить метод
                    </button>
                </ui-modal-trigger>
            </div>
        </div>
    </div>

    <ui-grid-custom grid-unique-id="gridShippingMethods"
                    grid-extend-ctrl="oneSettings"
                    grid-filter-enabled="false"
                    grid-selection-enabled="false"
                    grid-pagination-enabled="false"
                    grid-on-init="oneSettings.gridShippingMethodsOnInit(gridShippingMethods)"
                    grid-options="oneSettings.gridShippingMethodsOptions"
                    grid-inplace-url="'../OneSAdmin/inplaceShippingMethod'"
                    grid-url="'../OneSAdmin/getShippingMethods'">
        <ui-grid-custom-footer class="ui-grid-custom-footer" ng-bind="oneSettings.gridShippingMethods.gridOptions.TotalString">
        </ui-grid-custom-footer>
    </ui-grid-custom>

    <div class="form-group row middle-xs">
        <div class="col-xs-3">
            <div class="setting-label-wrap">
                <div class="setting-label-wrap">
                    Cтатус "Отказ получения"
                </div>
            </div>
        </div>
        <div class="col-xs-6 relative">
            <select ng-model="oneSettings.StatusRefusing" ng-options="s.label for s in oneSettings.settings.ExportOrder.OrderStatusList track by s.value" class="form-control"></select>
        </div>
    </div>

    <div class="form-group row middle-xs">
        <div class="col-xs-3">
            <button type="button" class="btn btn-sm btn-success" ng-click="oneSettings.importFromFile('CalculateShippings')" ng-disabled="oneSettings.file == null">
                Тест расчета доставки
            </button>
        </div>
        <div class="col-xs-6 relative">
            <a for="file" class="m-b-md" ngf-select="" ngf-change="oneSettings.selectFile($file)" ngf-accept="'.json'" style="vertical-align: initial; font-style:italic;">
                {{oneSettings.selectFileCaption}}
            </a>
        </div>
    </div>

    <div class="row m-b-md">
        <div class="col-xs-12">
            <div class="ibox" ng-if="oneSettings.IsRun">
                <div class="ibox-content">
                    <div class="row">
                        <div class="col-xs-12">
                            <uib-progressbar max="oneSettings.ProgressTotal" value="oneSettings.ProgressValue">
                                <span style="color:white; white-space:nowrap;"><span ng-bind="oneSettings.ProgressValue"></span> / <span ng-bind="oneSettings.ProgressTotal"></span></span>
                            </uib-progressbar>
                        </div>
                    </div>
                    <div class="container-fluid">
                        <div class="form-group row">
                            <div class="col-xs-10">
                                Текущий процесс
                                <a class="link-decoration-none" ng-href="{{oneSettings.Process}}" ng-bind="oneSettings.ProcessName"></a>
                            </div>
                            <div class="col-xs-2" ng-show="true">
                                <input type="button" ng-click="oneSettings.breakProcess()" class="btn btn-sm btn-success" value="Прервать" />
                            </div>
                        </div>
                    </div>
                    <div class="container-fluid" ng-if="!oneSettings.IsRun">
                        <div class="form-group row">
                            <div class="col-sm-12">
                                <div class="setting-label-wrap">
                                    Процесс завершен
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>