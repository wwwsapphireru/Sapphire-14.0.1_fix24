                <a href="" class="btn btn-sm btn-success" ng-click="aliCatalog.startProductPost(false)" style="background-color: #2d9cee; border-color: #2d9cee; color: #FFFFFF;">Проверить и выгрузить каталог товаров</a>
                <button type="button" class="btn btn-sm btn-success dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <span class="caret"></span>
                    <span class="sr-only">@T("Admin.Catalog.Index.Expand")</span>
                </button>
                <ul class="dropdown-menu pull-right">
                    <li class="dropdown-submenu">
                        <a href="" class="dropdown-menu-link js-menu-link" ng-click="aliCatalog.startCheckCatalog()">
                            Проверить каталог товаров
                        </a>
                    </li>
                </ul>
            </div>*@
                            <div class="btn-group m-l-xs">
                                @*<ui-modal-trigger class="btn btn-sm btn-success" size="xs-11" data-controller="'ModalOffersSelectvizrCtrl'" data-controller-as="ctrl"
                                  data-on-close="aliCatalog.addProductsToCategory(result)" ng-show="aliCatalog.selectedCategory.IsLeaf == true"
                                  template-url="../areas/admin/content/src/_shared/modal/offers-selectvizr/offersSelectvizrModal.html">
                    <a href="" class="" style="background-color: #2d9cee; border-color: #2d9cee; color: #FFFFFF;">Добавить товары</a>
