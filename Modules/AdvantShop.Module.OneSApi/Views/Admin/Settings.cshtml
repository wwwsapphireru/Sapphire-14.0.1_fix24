                                <button type="submit" class="btn btn-sm btn-success" data-button-validation data-button-validation-success="oneSettings.saveChanges()" ng-disabled="!oneSettingsForm.modified" disabled>
                                    <i class="fa fa-check"></i> @T("Admin.Save")
