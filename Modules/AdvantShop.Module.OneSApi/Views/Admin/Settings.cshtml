@using AdvantShop.Module.OneSApi
@{
    var url = UrlService.GetUrl();
    var scripts = new List<string>
    {
        url + "modules/" + OneSApi.ModuleStringId + "/content/scripts/admin/module-service.js",
        url + "modules/" + OneSApi.ModuleStringId + "/content/scripts/admin/settings/settings.js",
        url + "modules/" + OneSApi.ModuleStringId + "/content/scripts/admin/settings/modals/ModalAddEditDepot.js",
        url + "modules/" + OneSApi.ModuleStringId + "/content/scripts/admin/settings/modals/ModalAddEditShippingMethod.js",
    };
    var version = Html.GetModuleVersion(OneSApi.ModuleStringId);
}

<div data-oc-lazy-load="[@String.Join(",", scripts.Select(x => "'" + x + "?" + version + "'"))]">
    
    <div data-ng-controller="OneSettingsCtrl as oneSettings">

        <form name="oneSettingsForm" novalidate="novalidate">
            <div ng-init="oneSettings.oneSettingsForm=oneSettingsForm">

                <div>
                    <uib-tabset active uid="settingstab" on-select-batch="oneSettings.floatHeader = tab.heading;">
                        <uib-tab active index="0" heading="Импорт товаров" classes="ng-tab">
                            @Html.Partial("~/Modules/" + OneSApi.ModuleStringId + "/Views/Admin/_SettingsProductImport.cshtml")
                        </uib-tab>
                        <uib-tab active index="1" heading="Экспорт товаров" classes="ng-tab">
                            @Html.Partial("~/Modules/" + OneSApi.ModuleStringId + "/Views/Admin/_SettingsProductExport.cshtml")
                        </uib-tab>
                        <uib-tab active index="2" heading="Список складов" classes="ng-tab">
                            @Html.Partial("~/Modules/" + OneSApi.ModuleStringId + "/Views/Admin/_SettingsDepotList.cshtml")
                        </uib-tab>
                        <uib-tab active index="3" heading="Экспорт заказов" classes="ng-tab">
                            @Html.Partial("~/Modules/" + OneSApi.ModuleStringId + "/Views/Admin/_SettingsOrderExport.cshtml")
                        </uib-tab>
                        <uib-tab active index="4" heading="Импорт заказов" classes="ng-tab">
                            @Html.Partial("~/Modules/" + OneSApi.ModuleStringId + "/Views/Admin/_SettingsOrderImport.cshtml")
                        </uib-tab>
                        <uib-tab active index="5" heading="Импорт покупателей" classes="ng-tab">
                            @Html.Partial("~/Modules/" + OneSApi.ModuleStringId + "/Views/Admin/_SettingsCustomersImport.cshtml")
                        </uib-tab>
                        <uib-tab active index="6" heading="Методы доставки" classes="ng-tab">
                            @Html.Partial("~/Modules/" + OneSApi.ModuleStringId + "/Views/Admin/_SettingsShippingMethods.cshtml")
                        </uib-tab>
                        <div class="js-not-tabs page-name-block-item-AdditionTypeal">
