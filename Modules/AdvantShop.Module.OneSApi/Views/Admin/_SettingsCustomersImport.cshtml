
<h3 class="m-b">&nbsp;</h3>
<div class="container-fluid">

    <div class="form-group row middle-xs">
        <div class="col-xs-12">
            <div class="setting-title">
                <h3>Общее</h3>
            </div>
        </div>
    </div>

    <div class="form-group row middle-xs">
        <div class="col-xs-3">
            <div class="setting-label-wrap">
                Api key
            </div>
        </div>
        <div class="col-xs-6 relative">
            <input type="text" ng-model="oneSettings.apiKey" readonly="readonly" class="form-control" />
        </div>
    </div>

    <div class="form-group row middle-xs">
        <div class="col-xs-3">
            <div class="setting-label-wrap">
                Начальная группа пользователя
            </div>
        </div>
        <div class="col-xs-6 relative">
            <select ng-model="oneSettings.customerGroupId" ng-options="s.label for s in oneSettings.customerGroupList track by s.value" class="form-control"></select>
        </div>
    </div>

    @*<div class="form-group row middle-xs">
            <div class="col-xs-3">
                <div class="setting-label-wrap">
                    Создавать новых покупателей из 1С
                </div>
            </div>
            <div class="col-xs-6 relative">
                <label class="adv-checkbox-label">
                    <input type="checkbox" class="adv-checkbox-input" ng-model="oneSettings.settings.ImportOrder.CreateCustomers" />
                    <span class="adv-checkbox-emul"></span>
                </label>
            </div>
        </div>*@

    <div class="form-group row middle-xs">
        <div class="col-xs-12">
            <div class="setting-title">
                <h3>Обновление</h3>
            </div>
        </div>
    </div>

    <div class="form-group row middle-xs">
        <div class="col-xs-3">
            <div class="setting-label-wrap">
                Добавлять покупателей из 1С
            </div>
        </div>
        <div class="col-xs-6 relative">
            <label class="adv-checkbox-label">
                <input type="checkbox" class="adv-checkbox-input" ng-model="oneSettings.settings.ImportCustomer.AddCustomers" />
                <span class="adv-checkbox-emul"></span>
            </label>
        </div>
    </div>

    <div class="form-group row middle-xs">
        <div class="col-xs-3">
            <div class="setting-label-wrap">
                Обновлять покупателей из 1С
            </div>
        </div>
        <div class="col-xs-6 relative">
            <label class="adv-checkbox-label">
                <input type="checkbox" class="adv-checkbox-input" ng-model="oneSettings.settings.ImportCustomer.UpdateCustomers" />
                <span class="adv-checkbox-emul"></span>
            </label>
        </div>
    </div>

    <div class="form-group row middle-xs">
        <div class="col-xs-3">
            <div class="setting-label-wrap">
                Удалять покупателей из 1С
            </div>
        </div>
        <div class="col-xs-6 relative">
            <label class="adv-checkbox-label">
                <input type="checkbox" class="adv-checkbox-input" ng-model="oneSettings.settings.ImportCustomer.DeleteCustomers" />
                <span class="adv-checkbox-emul"></span>
            </label>
        </div>
    </div>

    <div class="form-group row middle-xs">
        <div class="col-xs-3">
            <div class="setting-label-wrap">
                Шаблон подписи менеджера
            </div>
        </div>
        <div class="col-xs-6 relative">
            <textarea type="text" ng-model="oneSettings.settings.ImportCustomer.ManagerSignTemplate" class="form-control"></textarea>
        </div>
    </div>

    <div class="form-group row middle-xs">
        <div class="col-xs-12">
            <div class="setting-title">
                <h3>Удаление менеджера из заказов</h3>
            </div>
        </div>
    </div>

    <div class="form-group row middle-xs">
        <div class="col-xs-3">
            <button type="button" class="btn btn-sm btn-success" ng-click="oneSettings.deleteManagerFromOrders()" ng-disabled="oneSettings.managerIdForDelete == '0'">
                Удалить менеджера
            </button>
        </div>
        <div class="col-xs-6 relative">
            <select ng-model="oneSettings.managerIdForDelete" ng-options="s.label for s in oneSettings.managerForDeleteList track by s.value" class="form-control"></select>
        </div>
    </div>

    <div class="form-group row middle-xs">
        <div class="col-xs-12">
            <div class="setting-title">
                <h3>Загрузка из файла</h3>
            </div>
        </div>
    </div>

    <div class="form-group row middle-xs">
        <div class="col-xs-3">
            <button type="button" class="btn btn-sm btn-success" ng-click="oneSettings.importFromFile('ImportCustomersFromFile')" ng-disabled="oneSettings.file == null">
                Загрузить данные
            </button>
        </div>
        <div class="col-xs-6 relative">
            <a for="file" class="m-b-md" ngf-select="" ngf-change="oneSettings.selectFile($file)" ngf-accept="'.json'" style="vertical-align: initial; font-style:italic;">
                {{oneSettings.selectFileCaption}}
            </a>
        </div>
    </div>

    <div class="row m-b-md">
        <div class="col-xs-12">
            <div class="ibox" ng-if="oneSettings.IsRun">
                <div class="ibox-content">
                    <div class="row">
                        <div class="col-xs-12">
                            <uib-progressbar max="oneSettings.ProgressTotal" value="oneSettings.ProgressValue">
                                <span style="color:white; white-space:nowrap;"><span ng-bind="oneSettings.ProgressValue"></span> / <span ng-bind="oneSettings.ProgressTotal"></span></span>
                            </uib-progressbar>
                        </div>
                    </div>
                    <div class="container-fluid">
                        <div class="form-group row">
                            <div class="col-xs-10">
                                Текущий процесс
                                <a class="link-decoration-none" ng-href="{{oneSettings.Process}}" ng-bind="oneSettings.ProcessName"></a>
                            </div>
                            <div class="col-xs-2" ng-show="true">
                                <input type="button" ng-click="oneSettings.breakProcess()" class="btn btn-sm btn-success" value="Прервать" />
                            </div>
                        </div>
                    </div>
                    <div class="container-fluid" ng-if="!oneSettings.IsRun">
                        <div class="form-group row">
                            <div class="col-sm-12">
                                <div class="setting-label-wrap">
                                    Процесс завершен
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
